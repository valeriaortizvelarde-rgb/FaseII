# ==== Proveedor LLM: "ollama" (local, sin credenciales) o "azure" (Azure OpenAI) ====
LLM_PROVIDER=ollama

# ==== Configuración de modelos (Azure OpenAI u Ollama, según LLM_PROVIDER) ====
# Ollama: http://localhost:11434/v1  |  Azure: https://<recurso>.openai.azure.com
OPENAI_ENDPOINT=http://localhost:11434/v1
# Ollama: cualquier valor (no se valida)  |  Azure: tu API key real
OPENAI_API_KEY=ollama
# Sólo aplica si LLM_PROVIDER=azure
OPENAI_API_VERSION=
# Ollama: nombre del modelo de chat local (p.ej. llama3.1)  |  Azure: nombre del deployment
OPENAI_CHAT_MODEL=llama3.2

# ==== Embeddings locales con Sentence Transformers vía Ollama ====
EMBEDDING_ENDPOINT=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
OPENAI_EMBEDDING_MODEL=all-minilm

# ==== OpenSearch configuration ====
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX=uber_drives

S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=rag-documents

# ==== Ingesta ====
# Ruta a la fuente CSV activa (relativa a la raíz del proyecto)
SOURCE_CSV_PATH=resources/data/uber_drives.csv


